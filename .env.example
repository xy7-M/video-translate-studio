# ── Supabase（邮箱登录 + AI 云代理）──
# 项目 URL 与 anon key 在 Supabase 控制台 Project Settings → API 获取
# anon key 可公开（只能触发 Edge Function，密钥与配额在服务端）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 注意：DeepSeek 密钥不再放在本机！
# 它作为服务端 secret 存在 Supabase Edge Function 里：
#   supabase secrets set DEEPSEEK_API_KEY=sk-xxxx
# 请在 https://platform.deepseek.com/api_keys 为该 Key 设置消费上限 100 元

# 可选配置（一般不用改）
# Whisper 模型: tiny / base / small / medium（精度越高越慢）
WHISPER_MODEL=small
# 若 HuggingFace 下载被墙，可改用镜像: https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com
